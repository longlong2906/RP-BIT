find_package(Boost 1.82.0 EXACT REQUIRED)
target_sources(terrain25d PRIVATE src/Corridor.cpp)
target_link_libraries(terrain25d PRIVATE Boost::headers)
add_executable(corridor_tests tests/unit/corridor_tests.cpp)
target_link_libraries(corridor_tests PRIVATE terrain25d)
add_test(NAME corridor_v3_core COMMAND corridor_tests)
set_tests_properties(corridor_v3_core PROPERTIES LABELS corridor_v3)
foreach(component protocol runner validation analysis)
  add_test(NAME corridor_v3_${component} COMMAND ${Python3_EXECUTABLE}
    ${CMAKE_SOURCE_DIR}/tests/test_corridor_v3_${component}.py)
  set_tests_properties(corridor_v3_${component} PROPERTIES LABELS corridor_v3)
endforeach()
if(TERRAIN_WITH_OMPL)
  add_test(NAME corridor_v3_worker COMMAND ${Python3_EXECUTABLE}
    ${CMAKE_SOURCE_DIR}/tests/test_corridor_v3_worker.py --worker $<TARGET_FILE:terrain_benchmark>)
  set_tests_properties(corridor_v3_worker PROPERTIES LABELS corridor_v3)
endif()
if(WIN32)
  get_property(corridor_tests_all DIRECTORY PROPERTY TESTS)
  foreach(name IN LISTS corridor_tests_all)
    if(name MATCHES "^corridor_v3_")
      set_tests_properties(${name} PROPERTIES ENVIRONMENT_MODIFICATION
        "PATH=path_list_prepend:${CMAKE_SOURCE_DIR}/.deps/install/lib;PATH=path_list_prepend:C:/mingw64/bin;PATH=path_list_prepend:C:/Users/Long/anaconda3/Library/bin")
    endif()
  endforeach()
endif()
